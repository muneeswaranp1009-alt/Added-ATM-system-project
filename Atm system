balance = 5000

def show_menu():
    print("\n--------------Munish ATM--------------")
    print("\n")
    print("1.Deposit")
    print("2.Check Balance")
    print("3.Withdraw")
    print("4.Exit")


def deposit(amount):
    global balance
    if amount <= 0:
        print("The amount must be positive.")
    else:
        balance += amount
        print(f"Deposit successful Rs.{amount:.2f}")
        print(f"Current balance: Rs.{balance:.2f}")
        

def check_balance(balance):
    print(f"Your BAlance is Rs.{balance:.2f}")
    
    
def withdraw(amount):
    global balance
    if amount > balance:
        print("Insufficient balance.")
    elif amount <=0:
        print("Enter a valid amount.")
    else:
        balance -= amount
        print(f"Withdrawal amount Rs.{amount:.2f}")
        print(f"Current balance: Rs.{balance:.2f}")
        
        
while True:
    show_menu()
    choice = input("Enter your choice:")
    if choice =="1":
        amount = float(input("Enter the amount to deposit:"))
        deposit(amount)
        
        
    elif choice =="2":
        check_balance(balance)
        
    elif choice =="3":
        amount = float(input("Enter amount to withdraw:"))
        withdraw(amount)
        
    elif choice =="4":
        print("Thank you for using Munish ATM. Goodbye!")
        
        
    else:
        print("Invalid choice. Please try again.")
        
        